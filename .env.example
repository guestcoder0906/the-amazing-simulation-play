# Only for game.html (playing without Claude sign-in). Set these in Vercel -> Project Settings -> Environment Variables.
# The site's Claude: your Anthropic API key. Its limits are shared by everyone who plays without signing in.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"
# Optional per-visitor caps for that key (unset or 0 = none):
# SHARED_LIMIT_PER_10MIN=
# SHARED_LIMIT_PER_DAY=
# Optional: Gemini for quick work and listening on game.html
GEMINI_API_KEY="MY_GEMINI_API_KEY"
